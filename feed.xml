---
# AUTHOR: toydotgame, J.H. van der Schee of Jekyll Codex
# CREATED: 2025-11-11
# Atom feed for my site. I'd like to personally thank the honourary co-author
# for the article (I first dismissed!) at
# https://jekyllcodex.org/without-plugin/rss-feed/
# I have spent the hour or two fighting jekyll-feed only to realise I'm
# literally a programmer and I can do it my damn self! Lol.
layout: null # Don't use the default page HTML markup, just spit out plain text
# DEV NOTE FOR MYSELF: XML requires void tags to self-close by ending with `/>`,
# not `>`. In HTML you don't need the slash but in XML you DO!!!
---

<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
	<link href="{{ page.url | absolute_url | xml_escape }}" rel="self"
		type="application/atom+xml" />
	<link href="{{ site.url | absolute_url | xml_escape }}" rel="alternate"
		type="text/html" />
	<generator version="{{ jekyll.version }}">Jekyll</generator>
	<title>{{ site.title | xml_escape }}</title>
	<subtitle>{{ site.tagline | default: site.description | xml_escape }}</subtitle>
	<id>{{ page.url | absolute_url | xml_escape }}</id>
	<updated>{{ site.time | date_to_xmlschema }}</updated>
	<author><name>{{ site.author | xml_escape }}</name></author>
	<icon>{{ site.feed.icon | absolute_url | xml_escape }}</icon>
	<logo>{{ site.feed.logo | absolute_url | xml_escape }}</logo>

	{% assign posts = site.posts | sort: "date" | reverse %}
	{% for post in posts
		{% if site.feed.length >= 0 %}limit: site.feed.length{% endif %} %}
		<entry>
			{% assign postTitle = post.title | default: post.url | strip_html
				| xml_escape %}
			<title>{{ postTitle }}</title>
			<link rel="alternate" href="{{ post.url | absolute_url
				| xml_escape }}" type="text/html" title="{{ postTitle }}" />
			<id>{{ post.url | absolute_url | xml_escape }}</id>
			<published>{{ post.date | date_to_xmlschema }}</published>
			<updated>{{ post.updated | default: post.date
				| date_to_xmlschema }}</updated>

			{% assign banner = post.image %}
			{% unless banner == site.defaults[0].values.image %}
				{% unless banner contains "://" %}
					{% assign banner = banner | absolute_url %}
				{% endunless %}
				<media:thumbnail xmlns:media="http://search.yahoo.com/mrss/"
					url="{{ banner | xml_escape }}" />
				<media:content xmlns:media="http://search.yahoo.com/mrss/"
					medium="image" url="{{ banner | xml_escape }}" />
			{% endunless %}
			
			<summary>{{ post.description | default: post.excerpt
				| strip_html
				| truncatewords: site.defaults[0].values.seo_description_max_words
				| xml_escape }}</summary>
			<content type="html">{{ post.content | strip | xml_escape }}</content>
		</entry>
	{% endfor %}
</feed>
